{
  "name": "leadflow-agent",
  "version": "0.1.0",
  "description": "AI lead qualification agent with Arc USDC micro-payments",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "start:enrichment": "node agents/enrichment/index.js",
    "start:scoring": "node agents/scoring/index.js",
    "start:all": "concurrently \"npm run start:enrichment\" \"npm run start:scoring\" \"npm start\"",
    "dev": "nodemon index.js",
    "setup:wallet": "node scripts/setupWallet.js"
  },
  "dependencies": {
    "openai": "^4.0.0",
    "@circle-fin/x402-batching": "latest",
    "@x402/core": "latest",
    "@x402/evm": "latest",
    "viem": "^2.0.0",
    "express": "^4.18.0",
    "dotenv": "^16.0.0",
    "concurrently": "^8.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}