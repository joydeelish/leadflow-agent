# ── Arc / Circle ─────────────────────────────────────────────────────────────
ARC_PRIVATE_KEY=0x_your_orchestrator_private_key

ENRICHMENT_AGENT_WALLET=0x_enrichment_agent_public_address
SCORING_AGENT_WALLET=0x_scoring_agent_public_address

# ── Agent URLs ───────────────────────────────────────────────────────────────
# Local dev
ENRICHMENT_AGENT_URL=http://localhost:3001/enrich
SCORING_AGENT_URL=http://localhost:3002/score
# Production (set these after Railway deployment)
# ENRICHMENT_AGENT_URL=https://leadflow-enrichment.up.railway.app/enrich
# SCORING_AGENT_URL=https://leadflow-scoring.up.railway.app/score

ENRICHMENT_PORT=3001
SCORING_PORT=3002

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── WhatsApp / Meta ──────────────────────────────────────────────────────────
WHATSAPP_TOKEN=your_meta_graph_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
BUSINESS_WHATSAPP_NUMBER=+2348012345678

# ── Facebook OAuth (set after Meta app setup) ────────────────────────────────
FB_APP_ID=your_meta_app_id
FB_APP_SECRET=your_meta_app_secret
FB_VERIFY_TOKEN=leadflow_verify_2026

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
QUALIFY_THRESHOLD=70
# Set this to your Railway URL after deployment e.g:
# APP_URL=https://leadflow-agent.up.railway.app
APP_URL=http://localhost:3000
